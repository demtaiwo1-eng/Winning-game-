NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://ess:ess@localhost:5432/ess?schema=public
JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOW_CODESPACES=true
COMMISSION_BPS=200
# Paystack remains available only for supported collection flows; it is not the bank withdrawal provider.
PAYSTACK_WEBHOOK_SECRET=
DEFAULT_CURRENCY=NGN
WEB3_PROVIDER_URL=http://127.0.0.1:8545
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=1337
VITE_API_URL=http://localhost:5000/api/v1

# OPay merchant cashier and bank-transfer credentials (server-side only).
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
# Enable only after OPay activates merchant bank transfers for this account.
OPAY_TRANSFERS_ENABLED=false
# Defaults to OPay sandbox in test mode and production host in live mode.
OPAY_TRANSFER_BASE_URL=
