{
  "name": "@ess/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../../scripts/with-database.mjs tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ../../scripts/with-database.mjs node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "prisma validate && prisma generate && tsc --noEmit && vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "node ../../scripts/with-database.mjs prisma migrate dev",
    "db:deploy": "node ../../scripts/with-database.mjs prisma migrate deploy",
    "db:seed": "node ../../scripts/with-database.mjs tsx prisma/seed.ts",
    "db:studio": "node ../../scripts/with-database.mjs prisma studio",
    "test:db": "node ../../scripts/with-database.mjs vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
