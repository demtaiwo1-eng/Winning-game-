NODE_ENV=development
EPHINTA_ENVIRONMENT=development
PORT=5000
# Database selection: auto prefers local PostgreSQL and falls back to online.
# For a hosted PostgreSQL service, use its private connection URI.
DATABASE_MODE=auto
DATABASE_URL_LOCAL=postgresql://ess:ess@127.0.0.1:5432/ess?schema=public
DATABASE_URL_ONLINE=
DATABASE_URL=postgresql://ess:ess@127.0.0.1:5432/ess?schema=public
# Auto-generated by .devcontainer/post-create.sh (min 32 chars)
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost
ALLOW_CODESPACES=true
# Platform fee in basis points (200 = 2%)
COMMISSION_BPS=200
# Incoming wallet top-ups and outgoing bank withdrawals are fixed at 2% by API policy.
WALLET_TOPUP_FEE_BPS=200
BOOKING_COMMISSION_BPS=200
PAYOUT_FEE_BPS=200
# Legacy OPay credentials are TEST-only fallbacks. Keep all secrets server-side.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_TEST_MERCHANT_ID=
OPAY_TEST_PUBLIC_KEY=
OPAY_TEST_SECRET_KEY=
OPAY_TEST_TRANSFER_BASE_URL=https://sandbox-cashierapi.opayweb.com
# Dedicated production credentials; never reuse TEST keys.
OPAY_LIVE_MERCHANT_ID=
OPAY_LIVE_PUBLIC_KEY=
OPAY_LIVE_SECRET_KEY=
OPAY_LIVE_TRANSFER_BASE_URL=https://cashierapi.opayweb.com
OPAY_LIVE_MODE_READY=false
OPAY_TRANSFERS_ENABLED=false
OPAY_TRANSFER_BASE_URL=
DEFAULT_CURRENCY=NGN
APP_BASE_URL=http://localhost:4173
# Fill these when SMTP credentials are available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Future payment rail credentials.
PAYMENT_MODE=test
ALLOW_PRODUCTION_TEST_MODE=false
PAYSTACK_SECRET_KEY=
# Paystack webhook signing secret (whsec_...) for timestamped Paystack-Signature headers.
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Live payment providers (optional; demo mode if empty) ---
# Paystack: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
# Flutterwave: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
# Stripe (global cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
